{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "User Management Backend — JVM, HTTP, and Business Metrics",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Business Metrics",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Total Registrations",
      "description": "Cumulative successful user registrations",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "users_registered_total{application=\"user-management\"}",
          "legendFormat": "Registrations",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Successful Logins",
      "description": "Cumulative successful logins",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "users_login_total{application=\"user-management\", result=\"success\"}",
          "legendFormat": "Login Success",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Failed Logins",
      "description": "Cumulative failed login attempts",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "users_login_total{application=\"user-management\", result=\"failure\"}",
          "legendFormat": "Login Failures",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Active Users",
      "description": "Current number of users in the database",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "users_active_total{application=\"user-management\"}",
          "legendFormat": "Active Users",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "type": "stat",
      "title": "Logouts",
      "description": "Cumulative successful logouts",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "purple", "value": null }] },
          "unit": "short"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "users_logout_total{application=\"user-management\"}",
          "legendFormat": "Logouts",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Login Rate (success vs failure)",
      "description": "Login attempts per minute broken down by result",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Failures" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Successes" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(users_login_total{application=\"user-management\", result=\"success\"}[1m])",
          "legendFormat": "Successes",
          "refId": "A"
        },
        {
          "expr": "rate(users_login_total{application=\"user-management\", result=\"failure\"}[1m])",
          "legendFormat": "Failures",
          "refId": "B"
        }
      ]
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "User CRUD Operations Rate",
      "description": "Create / Update / Delete operations per minute",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(users_operations_total{application=\"user-management\", operation=\"create\"}[1m])",
          "legendFormat": "Create",
          "refId": "A"
        },
        {
          "expr": "rate(users_operations_total{application=\"user-management\", operation=\"update\"}[1m])",
          "legendFormat": "Update",
          "refId": "B"
        },
        {
          "expr": "rate(users_operations_total{application=\"user-management\", operation=\"delete\"}[1m])",
          "legendFormat": "Delete",
          "refId": "C"
        }
      ]
    },

    {
      "id": 9,
      "type": "timeseries",
      "title": "Login Duration (p50 / p95 / p99)",
      "description": "Login request processing latency percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(users_login_duration_seconds_bucket{application=\"user-management\"}[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(users_login_duration_seconds_bucket{application=\"user-management\"}[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(users_login_duration_seconds_bucket{application=\"user-management\"}[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Photo Upload Success vs Error",
      "description": "Photo upload events per minute",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Error" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Success" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(users_photo_uploads_total{application=\"user-management\", result=\"success\"}[1m])",
          "legendFormat": "Success",
          "refId": "A"
        },
        {
          "expr": "rate(users_photo_uploads_total{application=\"user-management\", result=\"error\"}[1m])",
          "legendFormat": "Error",
          "refId": "B"
        }
      ]
    },

    {
      "id": 20,
      "type": "row",
      "title": "HTTP Request Metrics",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }
    },

    {
      "id": 21,
      "type": "timeseries",
      "title": "HTTP Request Rate by URI",
      "description": "Requests per second grouped by URI",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"user-management\"}[1m]))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 22,
      "type": "timeseries",
      "title": "HTTP Error Rate (4xx / 5xx)",
      "description": "Rate of HTTP 4xx and 5xx responses",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx Errors" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "4xx Errors" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"user-management\", status=~\"4..\"}[1m]))",
          "legendFormat": "4xx Errors",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"user-management\", status=~\"5..\"}[1m]))",
          "legendFormat": "5xx Errors",
          "refId": "B"
        }
      ]
    },

    {
      "id": 23,
      "type": "timeseries",
      "title": "HTTP Response Latency (p95)",
      "description": "95th percentile response time per URI",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (uri, le) (rate(http_server_requests_seconds_bucket{application=\"user-management\"}[5m])))",
          "legendFormat": "p95 {{uri}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 30,
      "type": "row",
      "title": "JVM Metrics",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 }
    },

    {
      "id": 31,
      "type": "timeseries",
      "title": "JVM Heap Memory",
      "description": "Used vs committed heap memory",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"user-management\", area=\"heap\"}",
          "legendFormat": "Heap Used ({{id}})",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_committed_bytes{application=\"user-management\", area=\"heap\"}",
          "legendFormat": "Heap Committed ({{id}})",
          "refId": "B"
        }
      ]
    },

    {
      "id": 32,
      "type": "timeseries",
      "title": "JVM Non-Heap Memory",
      "description": "Metaspace and code cache usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"user-management\", area=\"nonheap\"}",
          "legendFormat": "Non-Heap Used ({{id}})",
          "refId": "A"
        }
      ]
    },

    {
      "id": 33,
      "type": "timeseries",
      "title": "JVM GC Pause Duration",
      "description": "Garbage collection pause time per GC",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 47 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"user-management\"}[1m])",
          "legendFormat": "GC Pause — {{action}} {{cause}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 34,
      "type": "timeseries",
      "title": "JVM Thread Count",
      "description": "Live, daemon and peak thread counts",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 47 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"user-management\"}",
          "legendFormat": "Live Threads",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{application=\"user-management\"}",
          "legendFormat": "Daemon Threads",
          "refId": "B"
        },
        {
          "expr": "jvm_threads_peak_threads{application=\"user-management\"}",
          "legendFormat": "Peak Threads",
          "refId": "C"
        }
      ]
    },

    {
      "id": 40,
      "type": "row",
      "title": "Database Connection Pool (HikariCP)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 55 }
    },

    {
      "id": 41,
      "type": "timeseries",
      "title": "HikariCP Active vs Idle Connections",
      "description": "Active, idle and pending connection counts",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"user-management\"}",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"user-management\"}",
          "legendFormat": "Idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"user-management\"}",
          "legendFormat": "Pending",
          "refId": "C"
        }
      ]
    },

    {
      "id": 42,
      "type": "timeseries",
      "title": "HikariCP Connection Acquisition Time (p95)",
      "description": "Time to acquire a DB connection from the pool",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(hikaricp_connections_acquire_seconds_bucket{application=\"user-management\"}[5m]))",
          "legendFormat": "p95 Acquire Time",
          "refId": "A"
        }
      ]
    },

    {
      "id": 50,
      "type": "row",
      "title": "System & Process",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 64 }
    },

    {
      "id": 51,
      "type": "timeseries",
      "title": "CPU Usage",
      "description": "Process CPU and system CPU usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 65 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "custom": { "lineWidth": 2 }, "max": 1, "min": 0 }
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "process_cpu_usage{application=\"user-management\"}",
          "legendFormat": "Process CPU",
          "refId": "A"
        },
        {
          "expr": "system_cpu_usage{application=\"user-management\"}",
          "legendFormat": "System CPU",
          "refId": "B"
        }
      ]
    },

    {
      "id": 52,
      "type": "timeseries",
      "title": "Process Uptime",
      "description": "How long the application has been running",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 65 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "process_uptime_seconds{application=\"user-management\"}",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ]
    }

  ],

  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["spring-boot", "user-management", "prometheus"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "User Management Backend",
  "uid": "user-mgmt-backend-v1",
  "version": 1
}
